{{ form_start(form) }}

    <div class="row label-icons-form">

        <div class="col-12">

            {% if not article.id %}

                {% if form.imageFile is defined %}
                    <img class="article-image" id="articleImgOutput" src="" alt="">
                {% endif %}

            {% else %}

                {% if vich_uploader_asset(article) and not '.gif' in article.image %}
                    <img class="article-image" id="articleImgOutput" src="{{ vich_uploader_asset(article) | imagine_filter('article') }}" alt="">
                {% else %}
                    <img class="article-image" id="articleImgOutput" src="{{ vich_uploader_asset(article) }}" alt="">
                {% endif %}

            {% endif %}

            <div style="margin-top: 2px">
                {{ form_row(form.imageFile) }}
            </div>

            {{ form_row(form.title) }}
            {{ form_row(form.tags) }}
            {{ form_row(form.content) }}
            {{ form_row(form.moderation) }}

            <div class="form-spoiler">

                <a class="collapsed" data-toggle="collapse" data-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false">
                    {{ 'additional' | trans }} <i></i>
                </a>

                <div class="collapse" id="navbarToggleExternalContent">
                    <div class="chosen-songs">
                        {{ form_row(form.songs) }}
                    </div>
                    {{ form_row(form.eventDate) }}

                    {% if is_granted('ROLE_MODER') %}
                        <div class="chosen-search-off">
                            {{ form_widget(form.status) }}
                        </div>
                    {% endif %}
                </div>

            </div>

            <div class="mt-3">

                {% if not article.id %}
                    <button class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.publish.it' | trans }}')">
                        {{ 'add' | trans }}
                    </button>
                {% else %}
                    <button class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.change.it' | trans }}')">
                        {{ 'change' | trans }}
                    </button>
                {% endif %}

                <a class="btn btn-link float-right" href="{% if not article.id %}{{ path('app_home') }}{% else %}{{ path('article_show',{'slug':article.slug}) }}{% endif %}">
                    {{ 'cancel' | trans }}
                </a>

            </div>

        </div>

    </div>

{{ form_end(form) }}
