{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'activities' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'activities' | trans }}</h1>

        <a class="btn btn-info float-right" href="{{ path('dash_activity_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.activity' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'title' | trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for activity in activities %}
            <tr>
                <td>{{ activity.id }}</td>

                <td>
                    {{ activity.title }}
                    {{ crudActions(activity, 'activity') }}
                    <br><span class="small text-muted">{{ activity.slug }}</span>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{ 'no.records.found' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
