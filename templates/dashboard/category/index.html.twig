{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'categories' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'categories' | trans }}</h1>

        <a class="btn btn-info float-right" href="{{ path('dash_category_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.category' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'title' | trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>

                <td>
                    {{ category.title }}
                    {{ crudActions(category, 'category') }}
                    <br><span class="small text-muted">{{ category.slug }}</span>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{ 'no.records.found' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
