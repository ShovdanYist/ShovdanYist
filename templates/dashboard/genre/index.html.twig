{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'genres' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'genres' | trans }}</h1>

        <a class="btn btn-info float-right" href="{{ path('dash_genre_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.genre' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'title' | trans }}</th>
                <th>{{ 'image' | trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for genre in genres %}
            <tr>
                <td>{{ genre.id }}</td>

                <td>
                    {{ genre.title }}
                    {{ crudActions(genre, 'genre') }}
                    <br><span class="small text-muted">{{ genre.slug }}</span>
                </td>

                <td>
                    <div class="crud-picture" style="background-image: url('{{ vich_uploader_asset(genre) }}')">
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{ 'no.records.found' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
