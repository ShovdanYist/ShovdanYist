<div id="sideNavCloser">
    <div id="sideNavBack"></div>
</div>

<div id="sideNav">

    <div class="md-user-sidebar-profile">

        <div class="back-picture bp-40" style="background-image: url('{% if app.user.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(app.user.profile) }}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')"></div>

        <div class="md-user-sidebar-username">
            <span class="md-username">
                <a href="{{ path('user_profile', {'username' : app.user.username }) }}">
                    {{ app.user.username }}
                </a>
            </span>

            {% if app.user.profile.verified %}
                <span class="md-verified">
                    <i class="fas fa-check-circle text-info"></i>
                </span>
            {% endif %}
        </div>

    </div>

    <div class="sidenav-links">

        <a class="sidenav-link" href="{{ path('app_home') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-home"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'home.page' | trans }}
            </span>
        </a>

        <hr>

        <a class="sidenav-link" href="{{ path('dash_music_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-play-circle"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'music' | trans }}
            </span>
        </a>

        <a class="sidenav-link" href="{{ path('dash_activity_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-running"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'activities' | trans }}
            </span>
        </a>

        <a class="sidenav-link" href="{{ path('dash_people_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-users"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'people' | trans }}
            </span>
        </a>

        <hr>

        <a class="sidenav-link" href="{{ path('dash_theme_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-th-large"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'themes' | trans }}
            </span>
        </a>

        <a class="sidenav-link" href="{{ path('dash_genre_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-guitar"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'genres' | trans }}
            </span>
        </a>

        <a class="sidenav-link" href="{{ path('dash_category_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-stream"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'categories' | trans }}
            </span>
        </a>

        <hr>

        <a class="sidenav-link" href="{{ path('dash_user_index') }}">
            <span class="dashbar-nav-icon">
                <i class="fas fa-address-book"></i>
            </span>

            <span class="dashbar-nav-name">
                {{ 'users' | trans }}
            </span>
        </a>

    </div>

</div>
