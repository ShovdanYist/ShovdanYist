{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'music' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        {% if type == 'featureds' %}
            <h1>{{ 'featureds' | trans }}</h1>
        {% else %}
            <h1>{{ 'music' | trans }}</h1>
        {% endif %}

        <a class="btn btn-info float-right mb-3" href="{{ path('dash_music_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.music' | trans }}</span>
        </a>

        <a class="btn btn-outline-danger float-right mb-3" href="{{ path('dash_music_moderation') }}">
            <i class="fas fa-pen"></i>
            <span class="mobile-txt-hider">{{ 'in.moderation' | trans }}</span>
        </a>

        {% if type == 'featureds' %}
            <a class="btn btn-outline-success float-right mb-3" href="{{ path('dash_music_index') }}">
                <i class="fas fa-check"></i>
                <span class="mobile-txt-hider">{{ 'published' | trans }}</span>
            </a>
        {% else %}
            <a class="btn btn-outline-warning float-right mb-3" href="{{ path('dash_music_featureds') }}">
                <i class="fas fa-star"></i>
                <span class="mobile-txt-hider">{{ 'featureds' | trans }}</span>
            </a>
        {% endif %}

    </div>

{% endblock %}

{% block body %}

    <div class="scrollable-table">

        <table class="table table-striped table-middle-aligned">

            <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">{{ 'title' | trans }}</th>
                <th scope="col">{{ 'artist' | trans }}</th>
{#                <th scope="col">{{ 'publication.date' | trans }}</th>#}
{#                <th scope="col">{{ 'editing.date' | trans }}</th>#}
            </tr>
            </thead>

            <tbody>

            {% for music in musics %}

                <tr>

                    <td>{{ music.id }}</td>

                    <td>
                        <a href="{{ path('dash_music_edit', {'id': music.id}) }}">
                            {{ music.title }}
                        </a>
                        {% if music.featured %} <i class="fas fa-star text-warning"></i> {% endif %}

                        {{ crudActions(music, 'music') }}

                        <br><span class="small text-muted">{{ music.slug }}</span>
                    </td>

                    <td>
                        {% if music.artist %}
                            <a style="color: unset" href="{{ path('dash_music_vocalist',{'slug':music.artist.slug}) }}">
                                {{ music.artist.fullName }}
                            </a>
                        {% endif %}
                        <span class="small text-muted">
                            <br>{{ featuring( music, ',<br>' ) }}
                        </span>
                    </td>

{#                    <td>{{ music.publicationDate | format_datetime('medium', 'none', '', 'UTC') }}</td>#}
{#                    <td>{{ music.editingDate | format_datetime('medium', 'none', '', 'UTC') }}</td>#}

                </tr>

            {% else %}

                <tr>
                    <td colspan="9">{{ 'music.not.found' | trans }}</td>
                </tr>

            {% endfor %}

            </tbody>

        </table>

    </div>

    {{ paginator.display() }}

{% endblock %}
