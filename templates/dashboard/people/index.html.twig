{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'people' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'people' | trans }}</h1>

        <a class="btn btn-info float-right" href="{{ path('dash_people_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.person' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">

        <thead>

            <tr>
                <th>ID</th>
                <th>{{ 'form.full.name' | trans }}</th>
                <th>{{ 'image' | trans }}</th>
            </tr>

        </thead>

        <tbody>

        {% for person in people %}

            <tr>
                <td>{{ person.id }}</td>

                <td>
                    <a style="color: unset" href="{{ path('dash_song_vocalist',{'slug':person.slug}) }}">
                        {{ person.fullName }}
                    </a>

                    {{ crudActions(person, 'people') }}

                    <br><span class="small text-muted">{{ person.slug }}</span>

                    {% if person.songs.count > 0 %}
                        <span class="badge badge-pill badge-success">
                            {{ person.songs.count }}
                        </span>
                    {% endif %}
                </td>

                <td>
                    <div class="crud-picture" style="background-image: url('{{ vich_uploader_asset(person) }}')">
                    </div>
                </td>

            </tr>

        {% else %}

            <tr>
                <td colspan="9">{{ 'no.records.found' | trans }}</td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endblock %}
