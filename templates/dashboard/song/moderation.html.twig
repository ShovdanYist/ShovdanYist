{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'in.moderation' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'moderation' | trans }}</h1>

        <a class="btn btn-info float-right mb-3" href="{{ path('dash_song_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.song' | trans }}</span>
        </a>

        <a class="btn btn-outline-success float-right mb-3" href="{{ path('dash_song_index') }}">
            <i class="fas fa-check"></i>
            <span class="mobile-txt-hider">{{ 'published' | trans }}</span>
        </a>

        <a class="btn btn-outline-warning float-right mb-3" href="{{ path('dash_song_featureds') }}">
            <i class="fas fa-star"></i>
            <span class="mobile-txt-hider">{{ 'featureds' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">

        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">{{ 'title' | trans }}</th>
                <th scope="col">{{ 'vocalist' | trans }}</th>
{#                <th scope="col">{{ 'publication.date' | trans }}</th>#}
{#                <th scope="col">{{ 'editing.date' | trans }}</th>#}
            </tr>
        </thead>

        <tbody>

            {% for song in songs %}

                <tr>

                    <td>{{ song.id }}</td>

                    <td>
                        <a href="{{ path('song_show', {'slug': song.slug}) }}" target="_blank">
                            {{ song.title }}
                        </a>
                        {% if song.featured %} <i class="fas fa-star text-warning"></i> {% endif %}

                        {{ crudActions(song, 'song') }}

                        <br><span class="small text-muted">{{ song.slug }}</span>
                    </td>

                    <td>
                        {% if song.vocalist %}
                            {{ song.vocalist.fullName }}
                        {% endif %}
                        <span class="small text-muted">
                            <br>{{ featuring( song, ',<br>' ) }}
                        </span>
                    </td>

{#                    <td>{{ song.publicationDate | format_datetime('medium', 'none', '', 'UTC') }}</td>#}

{#                    <td>{{ song.editingDate | format_datetime('medium', 'none', '', 'UTC') }}</td>#}

                </tr>

            {% else %}

                <tr>
                    <td colspan="9">{{ 'song.not.found' | trans }}</td>
                </tr>

            {% endfor %}

        </tbody>

    </table>

    {{ paginator.display() }}

{% endblock %}
