{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'song' | trans }} {{ person.fullName }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ person.fullName }}</h1>

        <a class="btn btn-info float-right mb-3" href="{{ path('dash_song_new', {'person':person.id}) }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.song' | trans }}</span>
        </a>

        <a class="btn btn-outline-success float-right mb-3" href="{{ path('dash_song_index') }}">
            <i class="fas fa-pen"></i>
            <span class="mobile-txt-hider">{{ 'published' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <div class="scrollable-table">

        <table class="table table-striped table-middle-aligned">

            <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">{{ 'title' | trans }}</th>
                <th scope="col">{{ 'vocalist' | trans }}</th>
                <th scope="col">{{ 'status' | trans }}</th>
            </tr>
            </thead>

            <tbody>

            {% for song in person.songs %}

                <tr>

                    <td>{{ song.id }}</td>

                    <td>
                        <a href="{{ path('dash_song_edit', {'id': song.id}) }}">
                            {{ song.title }}
                        </a>
                        {% if song.featured %} <i class="fas fa-star text-warning"></i> {% endif %}

                        {{ crudActions(song, 'song') }}

                        <br><span class="small text-muted">{{ song.slug }}</span>
                    </td>

                    <td>
                        {% if song.vocalist %}
                            {{ song.vocalist.fullName }}
                        {% endif %}
                        <span class="small text-muted">
                            <br>{{ featuring( song, ',<br>' ) }}
                        </span>
                    </td>

                    <td>
                        {{ song.status ? '<span class="badge badge-pill badge-success">on</span>' : '<span class="badge badge-pill badge-danger">off</span>' }}
                    </td>

                </tr>

            {% else %}

                <tr>
                    <td colspan="9">{{ 'song.not.found' | trans }}</td>
                </tr>

            {% endfor %}

            </tbody>

        </table>

    </div>

{% endblock %}
