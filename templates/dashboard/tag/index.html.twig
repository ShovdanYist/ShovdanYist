{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'tags' | trans }}{% endblock %}

{% block main_top %}

    <div class="container dash-crud-header">

        <h1>{{ 'tags' | trans }}</h1>

        <a class="btn btn-info float-right" href="{{ path('dash_tag_new') }}">
            <i class="fa fa-plus" aria-hidden="true"></i>
            <span class="mobile-txt-hider">{{ 'add.tag' | trans }}</span>
        </a>

    </div>

{% endblock %}

{% block body %}

    <table class="table table-striped table-middle-aligned">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'title' | trans }}</th>
                <th>{{ 'type' | trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for tag in tags %}
            <tr>
                <td>{{ tag.id }}</td>

                <td>
                    {{ tag.title }}
                    {{ crudActions(tag, 'tag') }}
                    <br><span class="small text-muted">{{ tag.slug }}</span>
                </td>

                <td>
                    {% if tag.type == 'music' %}
                        <span class="badge badge-success">
                            {{ tag.type }}
                        </span>
                    {% elseif tag.type == 'article' %}
                        <span class="badge badge-info">
                            {{ tag.type }}
                        </span>
                    {% endif %}
                </td>

            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{ 'no.records.found' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
