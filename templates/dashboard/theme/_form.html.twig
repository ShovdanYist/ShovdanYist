{{ form_start(form) }}

    <div class="row label-icons-form">

        <div class="col-12">

            <div id="output-content" style="border-radius: 3px;background-image: url('{% if theme.picture %}{{ vich_uploader_asset(theme) }}{% else %}{{ asset('assets/images/picture.jpg') }}{% endif %}')">
            </div>
            {{ form_row(form.pictureFile) }}
            {{ form_row(form.title) }}
            {{ form_row(form.slug) }}

            <button class="btn btn-primary">
                {{ button_label | default('add') | trans }}
            </button>

            <a class="btn btn-link float-right" href="{{ path('dash_theme_index') }}">
                {{ 'cancel' | trans }}
            </a>

        </div>

    </div>

{{ form_end(form) }}
