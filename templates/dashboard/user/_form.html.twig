{{ form_start(form) }}

    <div class="row label-icons-form">

        <div class="col-12">

            {{ form_row(form.username) }}
            {{ form_row(form.email) }}
            {{ form_row(form.roles) }}
            {{ form_row(form.password) }}

            <div class="mt-3">

                <button class="btn btn-primary">
                    {{ button_label | default('add') | trans }}
                </button>

                <a class="btn btn-link float-right" href="{{ path('dash_user_index') }}">
                    {{ 'cancel' | trans }}
                </a>

            </div>

        </div>

    </div>

{{ form_end(form) }}
