{% extends 'dashboard/base.html.twig' %}

{% block title %}{{ 'profile.editing' | trans }}{% endblock %}

{% block body %}

    <h1>{{ 'profile.editing' | trans }}</h1>

    {{ form_start(form) }}

    <div class="row label-icons-form">

        <div class="col-12">

            <div id="output-content" style="background-image: url('{% if user.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(user.profile) }}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')">
            </div>

            {{ form_row(form.avatarFile) }}
            {{ form_row(form.avatarDelete) }}
            {{ form_row(form.fullname) }}
            {{ form_row(form.verified) }}
            {{ form_row(form.about) }}
            {{ form_row(form.url) }}

            <div class="md-form-gender mb-2">
                {{ form_row(form.gender) }}
            </div>

            {{ form_row(form.birthday) }}

            <div class="mt-3">

                <button class="btn btn-primary">
                    {{ button_label | default('update') | trans }}
                </button>

                <a class="btn btn-link float-right" href="{{ path('dash_user_index') }}">
                    {{ 'cancel' | trans }}
                </a>

            </div>

        </div>

    </div>

    {{ form_end(form) }}

{% endblock %}

{% block scripts %}
    {{ ckeditor() }}
{% endblock %}
