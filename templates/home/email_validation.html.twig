{% extends 'base.html.twig' %}

{% block title %}{{ 'email.confirmation' | trans }}{% endblock %}

{% block body %}

	<h1>{{ 'email.confirmation' | trans }}</h1>

	{% if result is null %}
		<div class="md-comment-guest md-alert md-alert-success md-box-mb mb-0">
			<i class="fas fa-check"></i> Ваша электронная почта <b>{{ user.email }}</b> успешно подтверждена!
		</div>
	{% elseif result == false %}
		<div class="md-comment-guest md-alert md-alert-danger md-box-mb mb-0">
			<i class="fas fa-ban"></i> Вы заблокированы и не можете подтвердить свою почту
		</div>
	{% elseif result == true %}
		<div class="md-comment-guest md-alert md-alert-info md-box-mb mb-0">
			<i class="fas fa-info-circle"></i> Ваша электронная почта уже подтверждена
		</div>
	{% endif %}

{% endblock %}
