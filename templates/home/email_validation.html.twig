{% extends 'base.html.twig' %}

{% block title %}{{ 'email.confirmation' | trans }}{% endblock %}

{% block body %}

	<h1>{{ 'email.confirmation' | trans }}</h1>

	{% if result is null %}
		<div class="md-comment-guest md-alert md-alert-success md-box-mb mb-0">
			<i class="fas fa-check"></i> Ваша электронная почта <span style="color: #5f736f;font-weight: 500">{{ app.user.email }}</span> успешно подтверждена!
		</div>
	{% elseif result == false %}
		<div class="md-comment-guest md-alert md-alert-warning md-box-mb mb-0">
			<i class="fas fa-exclamation-triangle"></i> Время ссылки истёк, <a href="{{ path('user_settings') }}">отправьте на почту</a> новую ссылку
		</div>
	{% elseif result == true %}
		<div class="md-comment-guest md-alert md-alert-info md-box-mb mb-0">
			<i class="fas fa-info-circle"></i> Ваша электронная почта уже подтверждена или время ссылки истёк
		</div>
	{% endif %}


{% endblock %}
