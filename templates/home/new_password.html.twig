{% extends 'base.html.twig' %}

{% block title %}{{ 'password.recovery' | trans }}{% endblock %}

{% block body %}

	<h1>{{ 'password.recovery' | trans }}</h1>

	{{form_start(form)}}

		{{form_row(form.password.first)}}
		{{form_row(form.password.second)}}

		<button class="btn btn-primary mt-1" type="submit">{{ 'send' | trans }}</button>

	{{form_end(form)}}

{% endblock %}
