{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'email.confirmation' | trans }}{% endblock %}

{% block main %}

	<div class="md-box">

		<header class="user-title-block">
			{{ 'email.confirmation' | trans }}
		</header>

		<div class="md-content-padding">

			{% if user.status is null %}
				<div class="md-alert md-alert-warning md-box-mb mb-0">
					<i class="fas fa-exclamation-triangle"></i> Время ссылки истёк, <a href="{{ path('user_settings',{'username' : app.user.username}) }}">отправьте на почту</a> новую ссылку
				</div>
			{% elseif user.status == false %}
				<div class="md-alert md-alert-danger md-box-mb mb-0">
					<i class="fas fa-ban"></i> Вы заблокированы и не можете подтвердить свою почту
				</div>
			{% elseif user.status == true %}
				<div class="md-alert md-alert-success md-box-mb mb-0">
					<i class="fas fa-check"></i> Ваша электронная почта <b>{{ user.email | first }}****@{{ user.email | split('@',3)[1] }}</b> успешно подтверждена!
				</div>
			{% endif %}

		</div>

	</div>

{% endblock %}
