{% if article.image %}

    {% if '.gif' in article.image %}
        {% set article_image_link = vich_uploader_asset(article) %}
    {% else %}
        {% set article_image_link = vich_uploader_asset(article) | imagine_filter('article') %}
    {% endif %}

    <img class="article-image" width="100%" src="{{ article_image_link }}" alt="{{ article.title }}">

{% endif %}
