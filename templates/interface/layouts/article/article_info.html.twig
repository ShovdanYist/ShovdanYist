<div class="article-info">

    {% if article.anonymous %}
        <span class="avatar back-picture bp-24" style="background-image: url('{{ asset('assets/images/avatar.jpg') }}')">
        </span>
        <a class="username">
            anonyme
        </a>
    {% else %}
        <span class="avatar back-picture bp-24" style="background-image: url('{% if article.author.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(article.author.profile) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
        </span>

        <a class="username" href="{{ path('user_profile', {'username': article.author.username }) }}">
            {{ article.author.username }}
        </a>
    {% endif %}

    {% if article.author.profile.verified %}
        <span class="md-comment-verified">
            <i class="fas fa-check-circle text-info"></i>
        </span>
    {% endif %}

    <span class="date">
    {{ article.publishedAt ? article.publishedAt | format_datetime('medium', 'none', '', 'UTC') }}
    в
    {{ article.publishedAt ? article.publishedAt | date(' H:i') }}
    </span>

    {% if is_granted('ROLE_OWNER') %}
        <span class="article-views float-right">
            <i class="fas fa-eye"></i> {{ article.views }}
        </span>
    {% endif %}

</div>
