<div class="md-article">

    <div class="md-articles-article md-box md-content-padding">

        {{ articleInfo(article) }}
        {{ articleTitle(article) }}
        {{ articleTags(article) }}
        {{ articleImage(article) }}

        {% for song in article.songs %}
            {{ player(song,null,null,null) }}
        {% endfor %}

        {% if type == 'moderation' %}
            <div class="mt-1">
                {{ articleDescription(article) }}
            </div>
            <hr>
        {% else %}
            {{ articleDescription(article) }}
        {% endif %}

        {% if type == 'moderation' %}
            <div class="mb-2">
                {{ article.content | raw }}
            </div>
            {{ rejectArticle(article) }}
        {% else %}
            {{ articleActions(article) }}
        {% endif %}

    </div>

</div>
