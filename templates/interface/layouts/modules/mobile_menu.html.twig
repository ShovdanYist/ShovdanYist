{% set pathname = app.request.get('_route') %}

{% if app.user %}

    <div class="mobile-menu">

        <div>
            <a href="{{ path('app_home') }}">
                <i class="fas fa-home"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('song_index') }}">
                <i class="fas fa-headphones-alt"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('message_conversations')}}">
                <i class="far fa-comment"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('user_notifications') }}">
                <i class="far fa-heart"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('user_profile', {'username':app.user.username}) }}">
                <i class="far fa-user"></i>
            </a>
        </div>

    </div>

{% else %}

    <div class="mobile-menu">

        <div>
            <a href="{{ path('app_home') }}"{% if pathname == 'app_home' %} style="color: #ccc" {% endif %}>
                <i class="fas fa-home"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('song_index') }}"{% if pathname == 'song_index' %} style="color: #ccc" {% endif %}>
                <i class="fas fa-headphones-alt"></i>
            </a>
        </div>

    </div>

{% endif %}
