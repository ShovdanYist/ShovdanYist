<style>
    .mobile-menu {
        position: fixed;
        width: 100%;
        bottom: 0;
        z-index: 999;
        background: url("https://shovdanyist.com/assets/images/container-border.png") repeat-x scroll 0 0/auto 1px #282828;
        height: 50px;
        display: none;
        justify-content: space-around;
    }
    .mobile-menu a {
        color: #626262;
        font-size: 22px;
        padding: 6px;
        top: 8px;
        position: relative;
    }
    .mobile-menu-badge {
        position: absolute;
        background-color: #e74c3c;
        font-size: 10px;
        color: #fff;
        border-radius: 30px;
        padding: 0 5px;
        bottom: 0;
        right: -12px;
    }
</style>

{% set pathname = app.request.get('_route') %}

{% if app.user %}

    <div class="mobile-menu">

        <div>
            <a href="{{ path('app_home') }}"{% if pathname == 'app_home' or pathname == 'post_feed' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-home"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('user_playlist') }}"{% if pathname == 'user_playlist' or pathname == 'song_index' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-music"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('message_conversations')}}"{% if pathname == 'message_conversations' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-comment"></i>
                {% if messagesCount(app.user) != 0 %}
                    <span class="mobile-menu-badge">
                    {% if messagesCount(app.user) > 99 %}
                        99+
                    {% else %}
                        {{ messagesCount(app.user) }}
                    {% endif %}
                </span>
                {% endif %}
            </a>
        </div>

        <div>
            <a href="{{ path('user_notifications') }}"{% if pathname == 'user_notifications' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-heart"></i>
                {% if notifyCount(app.user) != 0 %}
                    <span class="mobile-menu-badge">
                    {% if notifyCount(app.user) > 99 %}
                        99+
                    {% else %}
                        {{ notifyCount(app.user) }}
                    {% endif %}
                </span>
                {% endif %}
            </a>
        </div>

        <div>
            <a href="{{ path('user_profile', {'username':app.user.username}) }}"{% if pathname == 'user_profile' and user == app.user or pathname == 'user_tagged' and user == app.user %} style="color: #bbb" {% endif %}>
                <i class="fas fa-user"></i>
            </a>
        </div>

    </div>

{% else %}

    <div class="mobile-menu">

        <div>
            <a href="{{ path('app_home') }}"{% if pathname == 'app_home' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-home"></i>
            </a>
        </div>

        <div>
            <a href="{{ path('song_index') }}"{% if pathname == 'song_index' %} style="color: #bbb" {% endif %}>
                <i class="fas fa-music"></i>
            </a>
        </div>

    </div>

{% endif %}
