{% if app.user %}

    {% set user = app.user %}

    <div class="sidebar sticky-top">

        <div class="md-box sidebar-box">

            <div class="md-user-sidebar-profile">

                <div class="back-picture bp-45" style="background-image: url('{% if app.user.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(app.user.profile) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
                </div>

                <div class="md-user-sidebar-username">
                    <span class="md-username">
                        <a href="{{ path('user_profile', {'username' : user.username }) }}">
                            {{ user.username }}
                        </a>
                    </span>

                    {% if user.profile.verified %}
                        <span class="md-verified">
                            <i class="icon-check-circle-two text-info"></i>
                        </span>
                    {% endif %}
                </div>

            </div>

        </div>

        <div class="md-box">

            <div class="md-menu">

                {% set pathname = app.request.get('_route') %}

                <ul>

                    <li class="md-menu-item{% if pathname == 'app_home' %} active{% endif %}">
                        <a href="{{ path('app_home') }}">
                            <span>
                                <i class="icon-home"></i>
                            </span>
                            {{ 'feed' | trans }}
                        </a>
                    </li>

                    <li class="md-menu-item{% if pathname == 'post_recommendations' %} active{% endif %}">
                        <a href="{{ path('post_recommendations') }}">
                            <span>
                                <i class="icon-search"></i>
                            </span>
                            {{ 'recommendations' | trans }}
                        </a>
                    </li>

                    <li class="md-menu-item{% if pathname == 'message_conversations' or pathname == 'message_conversation' %} active{% endif %}">
                        <a href="{{ path('message_conversations') }}">
                            <span>
                                <i class="icon-send"></i>
                            </span>
                            {{ 'messages' | trans }}
                            {% if messagesCount(app.user) != 0 %}
                                <span class="badge badge-pill badge-danger float-right mt-1">
                                    {% if messagesCount(app.user) > 99 %}
                                        99+
                                    {% else %}
                                        {{ messagesCount(app.user) }}
                                    {% endif %}
                                </span>
                            {% endif %}
                        </a>
                    </li>

                    <li class="md-menu-item{% if pathname == 'user_notifications' or pathname == 'user_requests' %} active{% endif %}">
                        <a href="{{ path('user_notifications') }}">
                            <span>
                                <i class="icon-heart"></i>
                            </span>
                            {{ 'notifications' | trans }}
                            {% if notifyCount(app.user) != 0 %}
                                <span class="badge badge-pill badge-danger float-right mt-1">
                                    {% if notifyCount(app.user) > 99 %}
                                        99+
                                    {% else %}
                                        {{ notifyCount(app.user) }}
                                    {% endif %}
                                </span>
                            {% endif %}
                        </a>
                    </li>

                    <li class="md-menu-item{% if pathname == 'user_playlist' or pathname == 'song_index' %} active{% endif %}">
                        {% if app.user.playlistSongs.count %}
                            <a href="{{ path('user_playlist') }}">
                                <span>
                                    <i class="icon-music"></i>
                                </span>
                                {{ 'music' | trans }}
                            </a>
                        {% else %}
                            <a href="{{ path('song_index') }}">
                                <span>
                                    <i class="icon-music"></i>
                                </span>
                                {{ 'music' | trans }}
                            </a>
                        {% endif %}
                    </li>

                </ul>

            </div>

        </div>

    </div>

{% else %}

    <div class="md-box sidebar sticky-top">

        <div class="sidebar-box">

            <div class="md-menu">

                <ul>

                    <li class="md-menu-item">
                        <a href="{{ path('app_home') }}">
                            <span>
                                <i class="icon-home"></i>
                            </span>
                            {{ 'home.page' | trans }}
                        </a>
                    </li>

                    <li class="md-menu-item">
                        <a href="{{ path('post_recommendations') }}">
                            <span>
                                <i class="icon-search"></i>
                            </span>
                            {{ 'recommendations' | trans }}
                        </a>
                    </li>

                    <li class="md-menu-item">
                        <a href="{{ path('song_index') }}">
                            <span>
                                <i class="icon-music"></i>
                            </span>
                            {{ 'music' | trans }}
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </div>

{% endif %}
