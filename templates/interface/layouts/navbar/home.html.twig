<a class="md-nav-logo" href="{{ path('app_home') }}">
    <img src="{{ asset('/assets/images/logotype.png') }}" alt="Shovdan Yist">
</a>

{% if app.user %}
    {% if app.user %}
        <a class="navbar-menu-item right-second" href="{{ path('post_new') }}">
            <i class="icon-plus-circle"></i>
        </a>
    {% endif %}
    <a class="navbar-menu-item right" href="{{ path('message_conversations') }}">
        <i class="icon-message-circle"></i>
        {% if messagesCount(app.user) != 0 %}
            <span class="mobile-navbar-badge">
                {% if messagesCount(app.user) > 99 %}
                    99+
                {% else %}
                    {{ messagesCount(app.user) }}
                {% endif %}
            </span>
        {% endif %}
    </a>
{% else %}
    <a class="navbar-menu-item right" href="{{ path('app_login') }}">
        <i class="icon-user"></i>
    </a>
{% endif %}
