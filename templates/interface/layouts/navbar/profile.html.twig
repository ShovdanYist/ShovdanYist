<div class="navbar-menu-title">
    <h1>
        {% if user.closedAccount %}
            <span class="profile-lock">
                <i class="icon-lock"></i>
            </span>
        {% endif %}

        {% if 'user_follow' in app.request.get('_route') %}
            <a href="{{ path('user_profile', {'username':user.username}) }}">{{ user.username }}</a>
        {% else %}
            <span class="user-select-none">{{ user.username }}</span>
        {% endif %}

        {% if profile.verified == true %}
            <span class="verified">
                <i class="icon-check-circle-two text-info"></i>
            </span>
        {% endif %}
    </h1>
</div>

<div class="navbar-menu-item right actions">
    {% include 'interface/user/_actions.html.twig' with {'shareProfileId':'shareProfileMobile'} %}
</div>
