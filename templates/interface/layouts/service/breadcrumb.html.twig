<div class="md-box md-breadcrumb">

    <div class="md-breadcrumb-nav">

        <ol>

            {% for link,title in links %}

                {% if link != 'active' %}
                    <li class="breadcrumb-item"><a href="{{ link }}">{{ title }}</a></li>
                {% else %}
                    <li class="breadcrumb-item active">{{ title }}</li>
                {% endif %}

            {% endfor %}

        </ol>

    </div>

    {% if name %}

        {% if name == 'post' %}

            {% if is_granted('ROLE_POST_MODERATOR') or entity.author == app.user %}

                <button type="button" class="btn md-dot-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="right: 12px;top: 8px">
                    <i class="fas fa-ellipsis-h"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right">

                    <a href="{{ path('post_edit', {'id':entity.id}) }}" class="dropdown-item">
                        <i class="fa fa-edit"></i> {{ 'edit' | trans }}
                    </a>

                    {% if is_granted('ROLE_OWNER') or entity.author == app.user %}
                        <form method="post" action="{{ path('post_delete', {'id': entity.id}) }}" onsubmit="return confirm('{{ 'are.you.sure.to.delete' | trans }}');">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                            <button class="dropdown-item">
                                <i class="fas fa-trash-alt"></i> {{ 'delete' | trans }}
                            </button>
                        </form>
                    {% endif %}

                </div>

            {% endif %}

        {% elseif name == 'song' %}

            {% if is_granted('ROLE_SONG_EDITOR') %}

                <button type="button" class="btn md-dot-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="right: 12px;top: 8px">
                    <i class="fas fa-ellipsis-h"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right">

                    <a href="{{ path('song_edit', {'slug':entity.slug}) }}" class="dropdown-item">
                        <i class="fa fa-edit"></i> {{ 'edit' | trans }}
                    </a>

                    {% if is_granted('ROLE_OWNER') %}
                        <form method="post" action="{{ path('song_delete', {'id': entity.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.song' | trans }}');">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                            <button class="dropdown-item">
                                <i class="fas fa-trash-alt"></i> {{ 'delete' | trans }}
                            </button>
                        </form>
                    {% endif %}

                </div>

            {% endif %}

        {% elseif name == 'person' %}

            {% if is_granted('ROLE_PEOPLE_MODERATOR') %}

                <button type="button" class="btn md-dot-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="right: 12px;top: 8px">
                    <i class="fas fa-ellipsis-h"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right">

                    <a href="{{ path('person_edit', {'slug':entity.slug}) }}" class="dropdown-item">
                        <i class="fa fa-edit"></i> {{ 'edit' | trans }}
                    </a>

                    {% if is_granted('ROLE_OWNER') %}
                        <form method="post" action="{{ path('person_delete', {'id': entity.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.person' | trans }}');">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                            <button class="dropdown-item">
                                <i class="fas fa-trash-alt"></i> {{ 'delete' | trans }}
                            </button>
                        </form>
                    {% endif %}

                </div>

            {% endif %}

        {% elseif name == 'people' %}

            {% if is_granted('ROLE_PEOPLE_MODERATOR') %}
                <a class="breadcrumb-btn" href="{{ path('person_new') }}">
                    <i class="fas fa-plus"></i>
                </a>
            {% endif %}

        {% elseif name == 'song_add' %}

            {% if is_granted('ROLE_SONG_MODERATOR') %}
                <a class="breadcrumb-btn" href="{{ path('song_new') }}">
                    <i class="fas fa-plus"></i>
                </a>
            {% endif %}

        {% elseif name == 'user_add' %}

            <a class="breadcrumb-btn" href="{{ path('user_new') }}">
                <i class="fas fa-plus"></i>
            </a>

        {% elseif name == 'tag_add' %}

            <a class="breadcrumb-btn" href="{{ path('tag_new') }}">
                <i class="fas fa-plus"></i>
            </a>

        {% elseif name == 'activity_add' %}

            <a class="breadcrumb-btn" href="{{ path('activity_new') }}">
                <i class="fas fa-plus"></i>
            </a>

        {% endif %}

    {% endif %}

</div>
