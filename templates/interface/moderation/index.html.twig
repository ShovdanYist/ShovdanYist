{% extends 'interface/base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('app_home')) : ('home.page' | trans),
        'active' : 'moderation' | trans
    }) }}

    <div class="md-box md-content-padding md-margin-bottom manager-menu">

        <a href="{{ path('users_index') }}" class="btn">
            {{ 'users' | trans }}
        </a>

        <a href="{{ path('activities_index') }}" class="btn">
            {{ 'activities' | trans }}
        </a>

        <a href="{{ path('tags_index') }}" class="btn">
            {{ 'tags' | trans }}
        </a>

    </div>
{% endblock %}

{% block body %}

    <div class="scrollable-table">

        <table class="table table-center">

            <tbody>

                {% for stat in stats %}

                    <tr>
                        <th scope="row">{{ stat.name | trans }}</th>

                        <td>
                            {% if stat.moderation != 0 %}
                                <a href="{% if stat.name == 'songs' %}{{ path('moderation_ready' ) }}{% elseif stat.name == 'posts' %}{{ path('moderation_posts' ) }}{% endif %}">
                                    <span class="badge badge-pill badge-danger">
                                        {{ stat.moderation }}
                                    </span>
                                </a>
                            {% else %}
                                -
                            {% endif %}
                        </td>

                        <td>
                            {% if stat.published != 0 %}
                                <span class="badge badge-pill badge-success">
                                {{ stat.published }}
                            </span>
                            {% else %}
                                -
                            {% endif %}
                        </td>

                        <td>
                            <span class="badge badge-pill badge-primary">
                                {{ stat.total }}
                            </span>
                        </td>

                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

{% endblock %}
