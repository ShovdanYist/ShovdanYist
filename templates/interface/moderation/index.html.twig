{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'moderation' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('user_profile', {'username': app.user.username} )) : (app.user.username),
        'active' : 'moderation' | trans
    }) }}
{% endblock %}

{% block mobile_navbar %}
    {% include 'interface/layouts/navbar/title.html.twig' with {'title':'moderation'} %}
{% endblock %}

{% block main %}

    <div class="md-box md-margin-bottom">

        <div class="md-vertical-menu m-0">

            <a href="{{ path('moderation_posts') }}">
                <span class="icon">
                    <i class="icon-feather"></i>
                </span>
                <span>
                    {{ 'posts' | trans }}
                </span>
            </a>

            <a href="{{ path('moderation_music') }}">
                <span class="icon">
                    <i class="icon-headphones"></i>
                </span>
                <span>
                    {{ 'music' | trans }}
                </span>
            </a>

            <a href="{{ path('moderation_actions') }}">
                <span class="icon">
                    <i class="icon-book"></i>
                </span>
                <span>
                    {{ 'actions' | trans }}
                </span>
            </a>

            <a href="{{ path('moderation_reports') }}">
                <span class="icon">
                    <i class="icon-alert-triangle"></i>
                </span>
                <span>
                    {{ 'reports' | trans }}
                </span>
            </a>

            <a href="{{ path('users_index') }}">
                <span class="icon">
                    <i class="icon-users"></i>
                </span>
                <span>
                    {{ 'users' | trans }}
                </span>
            </a>

            <a href="{{ path('activities_index') }}">
                <span class="icon">
                    <i class="icon-coffee"></i>
                </span>
                <span>
                    {{ 'activities' | trans }}
                </span>
            </a>

            <a href="{{ path('tags_index') }}">
                <span class="icon">
                    <i class="icon-hash"></i>
                </span>
                <span>
                    {{ 'tags' | trans }}
                </span>
            </a>

        </div>

        <div class="md-content-padding md-mobile-padding">
            <div class="scrollable-table">
                <table class="table table-center">
                    <tbody>

                    {% for stat in stats %}
                        <tr>
                            <th scope="row" style="text-align: left;">{{ stat.name | trans }}</th>

                            <td>
                                {% if stat.moderation != 0 %}
                                    <a href="{% if stat.name == 'songs' %}{{ path('moderation_ready' ) }}{% elseif stat.name == 'posts' %}{{ path('moderation_posts' ) }}{% endif %}">
                                        <span class="badge badge-pill badge-danger">
                                            {{ stat.moderation }}
                                        </span>
                                    </a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>

                            <td>
                                {% if stat.published != 0 %}
                                    <span class="badge badge-pill badge-success">
                                    {{ stat.published }}
                                </span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>

                            <td>
                                <span class="badge badge-pill badge-primary">
                                    {{ stat.total }}
                                </span>
                            </td>

                        </tr>
                    {% endfor %}

                    </tbody>
                </table>
            </div>
        </div>

    </div>

{% endblock %}
