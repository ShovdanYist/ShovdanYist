{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'posts' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (is_granted('ROLE_OWNER')) ? path('moderation_index') : '' : 'moderation' | trans,
        'active' : ('posts' | trans),
    }) }}
{% endblock %}

{% block main %}

    {% for post in posts %}
        {{ postView(post, 'moderation') }}
    {% else%}
        <div class="md-box md-content-padding">{{ 'no.posts.in.moderation' | trans }}</div>
    {% endfor %}

    {{ paginator.display() }}

{% endblock %}
