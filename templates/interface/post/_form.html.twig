{{ form_start(form) }}

    <div class="row label-icons-form">

        <div class="col-12">

            {% if not post.id %}

                {% if form.imageFile is defined %}
                    <img class="post-image" id="postImgOutput" src="" alt="">
                {% endif %}

            {% else %}

                {% if vich_uploader_asset(post) and not '.gif' in post.image %}
                    <img class="post-image" id="postImgOutput" src="{{ vich_uploader_asset(post) | imagine_filter('post') }}" alt="">
                {% else %}
                    <img class="post-image" id="postImgOutput" src="{{ vich_uploader_asset(post) }}" alt="">
                {% endif %}

            {% endif %}

            <div style="margin-top: 2px">
                {{ form_row(form.imageFile) }}
            </div>

{#            {{ form_row(form.tags) }}#}
            {{ form_row(form.content) }}
{#            {{ form_row(form.moderation) }}#}

                {% if not post.id and userHavePlaylistSongs(app.user) or post.author == app.user and userHavePlaylistSongs(app.user) %}
                    {{ form_row(form.songs) }}
                {% elseif not post.id and not userHavePlaylistSongs(app.user) or post.author == app.user and not userHavePlaylistSongs(app.user) %}
                    <div class="form-group">
                        <label class="form-label" for="disabled_input">{{ 'music' | trans }}</label>
                        <input class="form-control" id="disabled_input" type="text" placeholder="{{ 'not.songs.in.your.playlist' | trans }}" disabled="">
                        <small class="form-text text-muted">{{ 'song.help' | trans }}</small>
                    </div>
                {% endif %}

                {% if is_granted('ROLE_POST_MODERATOR') %}
                    <div class="chosen-search-off">
                        {{ form_widget(form.status) }}
                    </div>
                {% endif %}

            <div class="mt-3">

                {% if not post.id %}
                    <button class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.publish.it' | trans }}')">
                        {{ 'add' | trans }}
                    </button>
                {% else %}
                    <button class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.change.it' | trans }}')">
                        {{ 'change' | trans }}
                    </button>
                {% endif %}

                <a class="btn btn-link float-right" href="{% if not post.id %}{{ path('app_home') }}{% else %}{{ path('post_show',{'slug':post.slug}) }}{% endif %}">
                    {{ 'cancel' | trans }}
                </a>

            </div>

        </div>

    </div>

{{ form_end(form) }}
