{% if post.image %}

    {% if '.gif' in post.image %}
        {% set post_image_link = vich_uploader_asset(post) %}
    {% else %}
        {% set post_image_link = vich_uploader_asset(post) | imagine_filter('post') %}
    {% endif %}

    {% if view == 'show' %}
        <img class="post-image" width="100%" src="{{ post_image_link }}" alt="{{ post.slug }}">
    {% else %}
        <a href="{{ path('post_show', {'slug':post.slug}) }}">
            <img class="post-image" width="100%" src="{{ post_image_link }}" alt="{{ post.slug }}">
        </a>
    {% endif %}

{% endif %}
