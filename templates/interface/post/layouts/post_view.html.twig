<div class="md-post">

    <div class="md-box md-content-padding">

        {{ postInfo(post) }}
        {% if post.title %}
            {% if view =='show' %}
                <h3>{{ post.title }}</h3>
            {% else %}
                {{ postTitle(post) }}
            {% endif %}
        {% endif %}
        {{ postTags(post) }}
        {{ postImage(post,view) }}

        {% if post.songs.count %}
            <div {% if view == 'show' %}class="md-margin-bottom" {% else %}style="margin-bottom: 10px" {% endif %}>
                {% for song in post.songs %}
                    {{ player(song,null,null,null) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if view == 'show' or view == 'moderation' %}
            <div class="ckeditor-content">
                {{ post.content | raw }}
            </div>
        {% else %}
            {{ postDescription(post) }}
        {% endif %}

        {{ postTaggedUsers(post) }}

        {% if post.status == true %}
            {% if view == 'show' %}
                {{ postActions(post,false) }}
            {% else %}
                {{ postActions(post,true) }}
            {% endif %}
        {% endif %}

        {% if view == 'moderation' %}
            <hr>
            {{ postValidation(post) }}
        {% endif %}

    </div>

</div>
