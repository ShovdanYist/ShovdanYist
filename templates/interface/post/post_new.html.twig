{% extends 'interface/base.html.twig' %}

{% block title %}

    {% if not is_granted('ROLE_POST_AUTHOR') %}
        {{ 'become.an.author' | trans }}
    {% else %}
        {{ 'post.adding' | trans }}
    {% endif %}

{% endblock %}

{% block body %}

    {% if not is_granted('ROLE_POST_AUTHOR') %}

        <h1>{{ 'become.an.author' | trans }}</h1>

        <div>
            Писать статьи могут только пользователи, которые имеют статус автора.
            <br>
            Если хотите стать автором, вам необходимо ознакомиться со следующими требованиями к авторам.
            <br>
            <br>

            <h5>1. Тема статей</h5>

            <p class="my-3">
                Преимущество данной площадки в том что можно писать статьи на любую тему, в переосмысленном виде, с нашей чеченской точки зрения, учитывая нашу религию, обычаи и традиции.
                <br>
                <br>
                Более того, если вы единственный человек в вашем окружении кто интересуется определенной темой, возможно здесь вы встретите единомышленников, которые помогут вам развиваться в этом направлении.
            </p>

            <h5>2. Эксклюзивность контента</h5>

            <p class="my-3">
                Никто вам не помешает вдохновляться чужими работами или перенимать определенные идеи других авторов, но в основе своем мы ждём от авторов свой собственный контент.
            </p>

            <h5>3. Качество изображения</h5>

            <p class="my-3">
                Нам очень важно чтобы авторы имели представление того что значит качество, будь то самой статьи или изображения.
            </p>

            <div class="md-pages-table-3">

                <div class="table-container">

                    <table class="table">
                        <tbody>
                        <tr>
                            <td colspan="3">
                                <img src="{{ asset('/assets/images/pages/become-an-author-1.png') }}" alt="...">
                            </td>
                        </tr>
                        <tr class="text-center">
                            <td>Качественное изображение</td>
                            <td>Изображние плохого качества</td>
                            <td>Скриншот изображения</td>
                        </tr>
                        <tr class="text-center">
                            <td><i class="fas fa-check text-success"></i></td>
                            <td><i class="fas fa-times text-danger"></i></td>
                            <td><i class="fas fa-times text-danger"></i></td>
                        </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <h5>4. Водяной знак</h5>

            <p class="my-3">
                Если у вас есть свой авторский логотип или подпись, то это хорошо. Но изображении которые похожи на баннеры из-за ссылок, логотипов и прочих надписей не приветствуются.
            </p>

            <div class="md-pages-table-3">

                <div class="table-container">

                    <table class="table">
                        <tbody>
                            <tr>
                                <td colspan="3">
                                    <img src="{{ asset('/assets/images/pages/become-an-author-2.png') }}" alt="...">
                                </td>
                            </tr>
                            <tr class="text-center">
                                <td>Аккуратный и красивый ваш авторский водяной знак</td>
                                <td>Неаккуратные водяные знаки</td>
                                <td>Любые чужие водяные знаки</td>
                            </tr>
                            <tr class="text-center">
                                <td><i class="fas fa-check text-success"></i></td>
                                <td><i class="fas fa-times text-danger"></i></td>
                                <td><i class="fas fa-times text-danger"></i></td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <h5>Обратная связь</h5>

            <p class="my-3">

                Если вы ознакомились с требованиями, и считаете что готовы писать статьи получив статус автора, свяжитесь с нами следующими способами.
                <br>
                <br>

                <a href="mailto:support@shovdanyist.com">
                    <i class="fas fa-envelope text-primary"></i> support@shovdanyist.com
                </a>

                <br>

                <a href="https://t.me/shovdanyist_support">
                    <i class="fab fa-telegram text-info"></i> shovdanyist
                </a>

                <br>

                <a href="https://instagram.com/shovdanyist">
                    <i class="fab fa-instagram text-secondary"></i> shovdanyist
                </a>

            </p>

        </div>

    {% else %}

        <h1>{{ 'post.adding' | trans }}</h1>

        {{ include('interface/post/_form.html.twig') }}

    {% endif %}

{% endblock %}

{% block scripts %}
    {{ ckeditor('author') }}
    {{ chosen() }}
    {{ chosen(10, '.chosen-music') }}
    {{ chosen(3,'.chosen-date select') }}
{% endblock %}
