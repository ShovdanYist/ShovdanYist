{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'recommendations' | trans }}{% endblock %}

{% block mobile_navbar %}
    {% include 'interface/layouts/navbar/search.html.twig' %}
{% endblock %}

{% block pageclass %}dark-background{% endblock %}

{% block main %}

    <div class="md-box">

        <div class="md-grid-posts mb-2">

            {% for post in posts %}

                <div class="md-grid-post">

                    <a href="{{ path('post_show', {'id':post.id}) }}">

                        <img src="{% if post.image %}{{ vich_uploader_asset(post) | imagine_filter('avatar') }}{% else %}{{ asset('assets/images/question.jpg') | imagine_filter('avatar') }}{% endif %}" alt="{{ post.slug }}">

                        <div class="md-grid-post-actions">

                            {% if is_granted('ROLE_OWNER') and app.user.closedAccount %}
                                <a class="btn featured-toggle{% if post.featured == true %} added{% endif %}" href="{{ path('post_featured', {'id': post.id}) }}">
                                    <span class="featured-icon"></span>
                                </a>
                            {% endif %}

                            {% if not post.status %}

                                <span class="status-icon" data-toggle="tooltip" title="{% if post.status is null %}{{ 'post.in.moderation' | trans }}{% else %}{{ 'post.is.rejected' | trans }}{% endif %}">
                                    {% if post.status is null %}
                                        <i class="icon-clock"></i>
                                    {% else %}
                                        <i class="icon-x-octagon"></i>
                                    {% endif %}
                                </span>

                            {% endif %}

                            {% if '.gif' in post.image %}
                                <span class="type-icon" data-toggle="tooltip" title="{{ 'animated.image' | trans }}">
                                    <i class="icon-loader"></i>
                                </span>
                            {% endif %}

                        </div>

                    </a>

                </div>

            {% endfor %}

        </div>

    </div>

    {{ paginator.display() }}

{% endblock %}

{% block scripts %}
    {{ autoplay() }}
{% endblock %}
