{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'search' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('app_home')) : ('home.page' | trans),
        'active' : ('users.for.keyword' | trans({'keyword': keyword})),
    }) }}
{% endblock %}

{% block main %}

    <div class="md-search">

        {% if users %}

            <div class="md-search-box md-box md-content-padding">

                {% for user in users %}

                    <div class="user-line">

                        <div class="back-picture bp-45" style="background-image: url('{% if user.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(user.profile) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}'); margin-right: 10px">
                        </div>

                        <div class="user-line-username" {% if user.profile.fullName %}style="line-height: unset"{% endif %}>
                            <span class="md-username">
                                <a href="{{ path('user_profile', {'username' : user.username }) }}">
                                    {{ user.username }}
                                </a>
                            </span>

                            {% if user.profile.verified %}
                                <span class="md-verified">
                                <i class="fas fa-check-circle text-info"></i>
                            </span>
                            {% endif %}
                        </div>

                        <span class="user-line-fullname">
                            {{ user.profile.fullName }}
                        </span>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

        {% if not users %}

            <div class="md-search-box md-box md-content-padding">
                {% if page > 1 %}
                    {{ 'not.found.users.for.keyword' | trans({'keyword':keyword}) }} {{ 'in.page' | trans({'page':page}) }}
                {% else %}
                    {{ 'not.found.users.for.keyword' | trans({'keyword':keyword}) }}
                {% endif %}
            </div>

        {% endif %}

    </div>

    {{ paginator.display(true) }}

{% endblock %}

{% block scripts %}
    {{ autoplay() }}
{% endblock %}
