{% extends 'interface/base.html.twig' %}

{% block og_title %}{{ vocalist.fullName }} | Биография, Дискография{% endblock %}

{% block og_image %}{{ vich_uploader_asset(vocalist) }}{% endblock %}

{% block og_type %}
    <meta property="og:type" content="profile">
    <meta property="profile:first_name" content="{{ vocalist.firstname }}">
    <meta property="profile:last_name" content="{{ vocalist.lastname }}">
{% endblock %}

{% block title %}{{ vocalist.fullName }} | Биография, Дискография{% endblock %}

{% block description %}В ShovdanYist вы сможете найти биографию, дискографию и все песни исполнителя {{ vocalist.fullName }}, а также все тексты чеченских песен и их переводы.{% endblock %}

{% block keywords %}{{ vocalist.fullName | lower }} биография, {{ vocalist.fullName | lower }} дискография, {{ vocalist.fullName | lower }} все песни, тексты чеченских песен, переводы чеченских песен, под гитару, чеченская музыка{% endblock %}

{% block main_top %}

    {{ breadcrumb({
        (path('app_home')) : ('home.page' | trans),
        (path('song_index')) : ('music' | trans),
        (path('song_vocalists', {letter: slugify(vocalist.fullName | first) })) : (vocalist.fullName | first),
        'active' : (vocalist.fullName),
    }, vocalist,'vocalist') }}

{% endblock %}

{% block body %}

    <div class="md-vocalist-card md-one-vocalist">

        <h1>{{ vocalist.fullName }}</h1>

        <div class="md-vocalist-block">

            <div class="md-vocalist-image" style="background-image: url('{% if vocalist.picture %}{{ vich_uploader_asset(vocalist) | imagine_filter('avatar') }}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')"></div>

            <div class="md-vocalist-body">

                <p class="card-text">

                    {% if vocalist.birthDay %}
                        <strong>{{ 'birth.date' | trans }}:</strong> {{ vocalist.birthDay ? vocalist.birthDay | format_datetime('medium', 'none', '', 'UTC') }}
                        <br>
                    {% endif %}

                    {% for profession in vocalist.activity %}
                        <span class="badge badge-success badge-lower">{{ profession.title }}</span>
                    {% endfor %}

                </p>

            </div>

        </div>

    </div>

    <table class="table table-striped table-middle-aligned md-table-carved">

        <thead class="thead-dark">
        <tr>
            <th scope="col"><i class="fas fa-closed-captioning"></i> {{ 'title' | trans }}</th>
            <th scope="col"><i class="fa fa-calendar"></i> {{ 'year' | trans }}</th>
            {% if is_granted('ROLE_OWNER') %}<th scope="col"><i class="fas fa-eye"></i> {{ 'views' | trans }}</th>{% endif %}
        </tr>
        </thead>

        <tbody>

        {% for song in songs %}

            <tr>
                <td>
                    <a href="{{ path('song_show', {slug: song.slug}) }}">{{ song.title }}</a>
                    <span class="small text-muted">
                        <br>{{ featuring( song, ',<br>' ) }}
                    </span>
                </td>
                <td>{{ song.releaseDate ? song.releaseDate | date("Y") }}</td>
                {% if is_granted('ROLE_OWNER') %}<td>{{ song.views }}</td>{% endif %}
            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endblock %}
