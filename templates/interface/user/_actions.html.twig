{% if user == app.user or rightToBlockUser(app.user,user) or rightToChangeUserRights(app.user,user) %}

    <button type="button" class="btn md-dot-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="fas fa-ellipsis-h"></i>
    </button>

    <div class="dropdown-menu dropdown-menu-right">

        {% if user == app.user or is_granted('ROLE_OWNER') %}

            <a href="{{ path('user_edit', {'username' : user.username}) }}" class="dropdown-item">
                <i class="fas fa-user-edit"></i> {{ 'edit' | trans }}
            </a>

            <a href="{{ path('user_settings', {'username' : user.username}) }}" class="dropdown-item">
                <i class="fas fa-cog"></i> {{ 'settings' | trans }}
            </a>

        {% endif %}

        {% if rightToChangeUserRights(app.user,user) %}

            <a href="{{ path('moderation_user_rights', {'username': user.username}) }}" class="dropdown-item">
                <i class="fas fa-shield-alt"></i> {{ 'rights' | trans }}
            </a>

        {% endif %}

        {% if rightToBlockUser(app.user,user) %}

            {% if user.status != false %}

                <a href="{{ path('moderation_block_user', {'id': user.id}) }}" class="dropdown-item" onclick="return confirm('{{ 'are.you.sure.to.block.user' | trans }}')">
                    <i class="fas fa-user-times"></i> {{ 'block' | trans }}
                </a>

            {% else %}

                <a href="{{ path('moderation_unblock_user', {'id': user.id}) }}" class="dropdown-item" onclick="return confirm('{{ 'are.you.sure.to.unblock.user' | trans }}')">
                    <i class="fas fa-user-check"></i> {{ 'unblock' | trans }}
                </a>

            {% endif %}

        {% endif %}

        {% if is_granted('ROLE_OWNER') %}

            <form method="post" action="{{ path('user_delete', {'id': user.id}) }}" onsubmit="return confirm('{{ 'are.you.sure.to.delete' | trans }}');">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="dropdown-item">
                    <i class="fas fa-trash-alt"></i> {{ 'delete' | trans }}
                </button>
            </form>

        {% endif %}

    </div>

{% endif %}
