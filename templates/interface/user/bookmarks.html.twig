{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'bookmarks' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('user_profile', {'username': app.user.username} )) : (app.user.username),
        'active' : ('bookmarks' | trans),
    }) }}
{% endblock %}

{% block main %}

    {% for post in posts %}

        <div class="md-post">

            <div class="md-{{ post.type }}-post md-box md-content-padding">

                {{ postInfo(post) }}
                {{ postTitle(post) }}
                {{ postTags(post) }}
                {{ postImage(post) }}
                {% for song in post.songs %}
                    {{ player(song,null,null,null) }}
                {% endfor %}
                {{ postDescription(post) }}
                {{ postActions(post) }}

            </div>

        </div>

    {% else %}

        <div class="md-box md-content-padding">{{ 'you.have.not.bookmarks' | trans }}</div>

    {% endfor %}

    {{ paginator.display('box') }}

{% endblock %}

{% block scripts %}
    {{ autoplay() }}
{% endblock %}
