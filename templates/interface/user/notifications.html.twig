{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'notifications' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('user_profile', {'username': app.user.username} )) : (app.user.username),
        'active' : ('notifications' | trans),
    }) }}
{% endblock %}

{% block body %}

    <div class="md-notifications">

        {% for notification in notifications %}

            {{ notificationView(notification) }}

        {% else %}

            <div class="text-center">
                <i class="far fa-bell" style="margin-right: 3px"></i>
                {{ 'you.have.not.notifications' | trans }}
            </div>

        {% endfor %}

    </div>

    {{ paginator.display() }}

{% endblock %}
