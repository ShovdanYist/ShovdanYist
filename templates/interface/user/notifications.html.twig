{% extends 'interface/base.html.twig' %}

{% block title %}{{ 'notifications' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('user_profile', {'username': app.user.username} )) : (app.user.username),
        'active' : ('notifications' | trans),
    }) }}
{% endblock %}

{% block body %}

    <div class="md-notifications">

        {% for notification in notifications %}

            {% if notification.type == 'comment_reply' %}

                <div class="md-notification md-comment-notification">

                    <div class="notify-sender-user">
                        <a href="{{ path('user_profile', {'username': notification.comment.author.username}) }}">
                            <span class="md-avatar md-avatar-50" style="background-image: url('{% if notification.comment.author.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(notification.comment.author.profile) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')"></span>
                        </a>
                    </div>

                    <div class="notify-message-body">

                        <div class="notify-message">

                            <a class="notify-message-user" style="font-weight: 500" href="{{ path('user_profile', {'username': notification.comment.author.username}) }}">
                                {{ notification.comment.author.profile.username }}
                            </a>

                            {% if notification.comment.author.profile.verified %}
                                <span class="md-comment-verified">
                                    <i class="fas fa-check-circle text-info"></i>
                                </span>
                            {% endif %}

                            {% if notification.quantity > 1 %}

                                {{ 'replied.you.with.comment.users' | trans }}

                                {% if notification.post %}
                                    {{ 'в статье' }} <a href="{{ path('post_show',{'slug':notification.post.slug}) }}">{{ notification.post.title }}</a>
                                {% elseif notification.song %}
                                    {{ 'в песне' }} <a href="{{ path('song_show', {'slug': notification.song.slug}) }}">{{ notification.song.fulltitle }}</a>
                                {% endif %}

                            {% elseif notification.comment.author.profile.gender %}
                                {{ 'replied.you.with.comment.female' | trans }}
                            {% else %}
                                {{ 'replied.you.with.comment.male' | trans }}
                            {% endif %}

                            {% if notification.quantity == 1 %}
                                {% if notification.comment.song %}
                                    <a class="notify-message-link" href="{{ path('song_show', {'slug': notification.comment.song.slug}) }}">
                                        <span style="font-weight: 500">{{ notification.comment.message }}</span>
                                    </a>
                                {% else %}
                                    <a class="notify-message-link" href="{{ path( 'post_show', {'slug': notification.comment.post.slug}) }}">
                                        <span style="font-weight: 500">{{ notification.comment.message }}</span>
                                    </a>
                                {% endif %}
                            {% endif %}

                            <br>

                            <small class="text-muted">
                                {{ notification.publishedAt ? notification.publishedAt | format_datetime('medium', 'none', '', 'UTC') }}
                                в
                                {{ notification.publishedAt ? notification.publishedAt | date(' H:i') }}

                                <form class="md-comment-reply" style="display: contents" method="post" action="{{ path('user_notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.notification' | trans }}');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
                                    <button class="comment-reply" style="display: contents">
                                        {{ 'delete' | trans }}
                                    </button>
                                </form>
                            </small>

                        </div>

                    </div>

                    <div class="notify-picture">
                        {% if notification.comment.song %}
                            <a href="{{ path('song_show', {'slug': notification.comment.song.slug}) }}">
                                <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url('{% if notification.comment.song.vocalist.picture %}{{ vich_uploader_asset(notification.comment.song.vocalist) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
                                </span>
                            </a>
                        {% else %}
                            <a href="{{ path( 'post_show', {'slug': notification.comment.post.slug}) }}">
                                <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url(' {% if notification.comment.post.image %}{{ vich_uploader_asset(notification.comment.post) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/question.jpg') }}{% endif %}')">
                                </span>
                            </a>
                        {% endif %}
                    </div>

                </div>

            {% elseif notification.type == 'post_comment' %}

                <div class="md-notification md-comment-notification">

                    <div class="notify-sender-user">
                        <a href="{{ path('user_profile', {'username': notification.comment.author.username}) }}">
                            <span class="md-avatar md-avatar-50" style="background-image: url('{% if notification.comment.author.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(notification.comment.author.profile) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')"></span>
                        </a>
                    </div>

                    <div class="notify-message-body">

                        <div class="notify-message">

                            <a class="notify-message-user" style="font-weight: 500" href="{{ path('user_profile', {'username': notification.comment.author.username}) }}">
                                {{ notification.comment.author.profile.username }}
                            </a>

                            {% if notification.comment.author.profile.verified %}
                                <span class="md-comment-verified">
                                    <i class="fas fa-check-circle text-info"></i>
                                </span>
                            {% endif %}

                            {% if notification.quantity > 1 %}
                                {{ ('commented.your.' ~ notification.post.type ~ '.users') | trans }}:
                            {% elseif notification.comment.author.profile.gender %}
                                {{ ('commented.your.' ~ notification.post.type ~ '.female') | trans }}:
                            {% else %}
                                {{ ('commented.your.' ~ notification.post.type ~ '.male') | trans }}:
                            {% endif %}

                            {% if notification.quantity == 1 %}
                                {% if notification.comment.song %}
                                    <a class="notify-message-link" href="{{ path('song_show', {'slug': notification.comment.song.slug}) }}">
                                        <span style="font-weight: 500">{{ notification.comment.message }}</span>
                                    </a>
                                {% else %}
                                    <a class="notify-message-link" href="{{ path( 'post_show', {'slug': notification.comment.post.slug}) }}">
                                        <span style="font-weight: 500">{{ notification.comment.message }}</span>
                                    </a>
                                {% endif %}
                            {% endif %}

                            <br>

                            <small class="text-muted">
                                {{ notification.publishedAt ? notification.publishedAt | format_datetime('medium', 'none', '', 'UTC') }}
                                в
                                {{ notification.publishedAt ? notification.publishedAt | date(' H:i') }}

                                <form class="md-comment-reply" style="display: contents" method="post" action="{{ path('user_notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.notification' | trans }}');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
                                    <button class="comment-reply" style="display: contents">
                                        {{ 'delete' | trans }}
                                    </button>
                                </form>
                            </small>

                        </div>

                    </div>

                    <div class="notify-picture">
                        {% if notification.comment.song %}
                            <a href="{{ path('song_show', {'slug': notification.comment.song.slug}) }}">
                                <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url('{% if notification.comment.song.vocalist.picture %}{{ vich_uploader_asset(notification.comment.song.vocalist) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/avatar.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
                                </span>
                            </a>
                        {% else %}
                            <a href="{{ path( 'post_show', {'slug': notification.comment.post.slug}) }}">
                                <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url(' {% if notification.comment.post.image %}{{ vich_uploader_asset(notification.comment.post) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/question.jpg') }}{% endif %}')">
                                </span>
                            </a>
                        {% endif %}
                    </div>

                </div>

            {% elseif notification.type == 'post_rejected' %}

                <div class="md-notification md-comment-notification">

                    <div class="notify-sender-user">
                        <a href="{{ path('user_profile', {'username':'shovdanyist'}) }}">
                            <span class="md-avatar md-avatar-50" style="background-image: url('{{ asset('assets/images/logo-avatar.jpg') }}')"></span>
                        </a>
                    </div>

                    <div class="notify-message-body">

                        <div class="notify-message">

                            <a class="notify-message-user" style="font-weight: 500" href="{{ path('user_profile', {'username':'shovdanyist'}) }}">
                                shovdanyist
                            </a>

                            <span class="md-comment-verified">
                                <i class="fas fa-check-circle text-info"></i>
                            </span>

                            {{ ('rejected.your.' ~ notification.post.type) | trans }}

                            {% if notification.post.type == 'article' %}
                                <a href="{{ path( 'post_show', {'slug': notification.post.slug}) }}">{{ notification.post.title }}</a>
                            {% endif %}

                            {{ 'for.next.reason' | trans }}:

                            <span style="font-weight: 500">{{ notification.message }}</span>

                            <br>

                            <small class="text-muted">
                                {{ notification.publishedAt ? notification.publishedAt | format_datetime('medium', 'none', '', 'UTC') }}
                                в
                                {{ notification.publishedAt ? notification.publishedAt | date(' H:i') }}

                                <form class="md-comment-reply" style="display: contents" method="post" action="{{ path('user_notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.notification' | trans }}');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
                                    <button class="comment-reply" style="display: contents">
                                        {{ 'delete' | trans }}
                                    </button>
                                </form>
                            </small>

                        </div>

                    </div>

                    <div class="notify-picture">
                        <a href="{{ path( 'post_show', {'slug': notification.post.slug}) }}">
                            <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url('{% if notification.post.image %}{{ vich_uploader_asset(notification.post) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/question.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
                            </span>
                        </a>
                    </div>

                </div>

            {% elseif notification.type == 'post_approved' %}

                <div class="md-notification md-comment-notification">

                    <div class="notify-sender-user">
                        <a href="{{ path('user_profile', {'username':'shovdanyist'}) }}">
                            <span class="md-avatar md-avatar-50" style="background-image: url('{{ asset('assets/images/logo-avatar.jpg') }}')"></span>
                        </a>
                    </div>

                    <div class="notify-message-body">

                        <div class="notify-message">

                            <a class="notify-message-user" style="font-weight: 500" href="{{ path('user_profile', {'username':'shovdanyist'}) }}">
                                shovdanyist
                            </a>

                            <span class="md-comment-verified">
                                <i class="fas fa-check-circle text-info"></i>
                            </span>

                            {{ ('approved.your.' ~ notification.post.type) | trans }}

                            {% if notification.post.type == 'article' %}
                                <a href="{{ path( 'post_show', {'slug': notification.post.slug}) }}">{{ notification.post.title }}</a>
                            {% endif %}

                            <br>

                            <small class="text-muted">
                                {{ notification.publishedAt ? notification.publishedAt | format_datetime('medium', 'none', '', 'UTC') }}
                                в
                                {{ notification.publishedAt ? notification.publishedAt | date(' H:i') }}

                                <form class="md-comment-reply" style="display: contents" method="post" action="{{ path('user_notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('{{ 'sure.to.delete.notification' | trans }}');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
                                    <button class="comment-reply" style="display: contents">
                                        {{ 'delete' | trans }}
                                    </button>
                                </form>
                            </small>

                        </div>

                    </div>

                    <div class="notify-picture">
                        <a href="{{ path( 'post_show', {'slug': notification.post.slug}) }}">
                            <span class="back-picture bp-50" style="border-radius: 3px;margin-right: 14px;background-image: url('{% if notification.post.image %}{{ vich_uploader_asset(notification.post) | imagine_filter('thumbnail') }}{% else %}{{ asset('assets/images/question.jpg') | imagine_filter('thumbnail') }}{% endif %}')">
                            </span>
                        </a>
                    </div>

                </div>

            {% endif %}

        {% else %}

            {{ 'you.have.no.notifications' | trans }}

        {% endfor %}

    </div>

    {{ paginator.display() }}

{% endblock %}
