    {% if comments %}
        <span class="stat">
            <a href="{{ path( 'article_show', {'slug': article.slug}) }}#comments">
                <i class="far fa-comment-alt" style="font-size: 22px;"></i>
                <span class="count">{{ article.comments.count }}</span>
            </a>
        </span>
    {% endif %}

    <span class="stat float-right m-0">

        {% if app.user %}
            <a class="bookmark-toggle bk-toggle{% if userContainArticle(app.user, article) %} added{% endif %}" href="{{ path('article_bookmarker', {'slug': article.slug}) }}">
                <span class="bookmark-icon"></span>
            </a>
        {% else %}
            <a class="bk-toggle" href="javascript:void(0)" style="cursor: pointer;padding-top: 5px;top: -5px;position: relative" data-toggle="tooltip" title="Добавлять посты в закладки можно только после авторизации">
                <span class="bookmark-icon"></span>
            </a>
        {% endif %}

    </span>

</div>
