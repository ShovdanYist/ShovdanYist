<div id="sideNavCloser">
    <div id="sideNavBack"></div>
</div>

<div id="sideNav">

    {% if app.user %}

        <div class="md-user-sidebar-profile">

            <div class="back-picture bp-40" style="background-image: url('{% if app.user.profile.avatar != 'avatar.jpg' %}{{ vich_uploader_asset(app.user.profile) }}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')"></div>

            <div class="md-user-sidebar-username">
                <span class="md-username">
                    <a href="{{ path('user_profile', {'username' : app.user.username }) }}">
                        {{ app.user.username }}
                    </a>
                </span>

                {% if app.user.profile.verified %}
                    <span class="md-verified">
                        <i class="fas fa-check-circle text-info"></i>
                    </span>
                {% endif %}
            </div>

        </div>

        <div class="sidenav-links">

            <a class="sidenav-link" href="{{ path('app_home') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-heading"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'articles' | trans }}
                </span>
            </a>

            <a class="sidenav-link" href="{{ path('music_index') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-music"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'music' | trans }}
                </span>
            </a>

            <hr>

            <a class="sidenav-link" href="{{ path('user_notifications') }}">

                <span class="dashbar-nav-icon">
                    <i class="fas fa-bell"></i>
                </span>

                    <span class="dashbar-nav-name">
                        {{ 'notifications' | trans }}
                    </span>

                {% if notifyCount(app.user) != 0 %}
                    <span class="badge badge-pill badge-danger mt-1 dashbar-nav-badge">
                        {% if notifyCount(app.user) > 99 %}
                            99+
                        {% else %}
                            {{ notifyCount(app.user) }}
                        {% endif %}
                    </span>
                {% endif %}

            </a>

            <a class="sidenav-link" href="{{ path('user_playlist', {'username': app.user.username}) }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-headphones"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'playlist' | trans }}
                </span>
            </a>

            <a class="sidenav-link" href="{{ path('user_bookmarks') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-bookmark"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'bookmarks' | trans }}
                </span>
            </a>

            {% if is_granted('ROLE_ARTICLE_MODERATOR') %}

                <hr>

                <a class="sidenav-link" href="{{ path('article_moderation') }}">
                    <span class="dashbar-nav-icon">
                        <i class="fas fa-tasks"></i>
                    </span>

                    <span class="dashbar-nav-name">
                        {{ 'moderation' | trans }}
                    </span>

                    {% if articleModerationCount() != 0 %}
                        <span class="badge badge-pill badge-danger mt-1 dashbar-nav-badge">
                        {% if articleModerationCount() > 99 %}
                            99+
                        {% else %}
                            {{ articleModerationCount() }}
                        {% endif %}
                    </span>
                    {% endif %}
                </a>

                {% if is_granted('ROLE_ADMIN') %}

                    <a class="sidenav-link" href="{{ path('dash_index') }}">

                        <span class="dashbar-nav-icon">
                            <i class="fas fa-tools"></i>
                        </span>

                        <span class="dashbar-nav-name">
                            {{ 'manager' | trans }}
                        </span>

                    </a>

                {% endif %}

            {% endif %}

            <hr>

            <a class="sidenav-link" href="{{ path('app_logout') }}" onclick="return confirm('{{ 'are.you.sure.to.log.out' | trans }}')">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-power-off"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'log.out' | trans }}
                </span>
            </a>

        </div>

    {% else %}

        <div class="sidenav-links">

            <a class="sidenav-link" href="{{ path('app_login') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-user-circle"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'log.in' | trans }}
                </span>
            </a>

            <hr>

            <a class="sidenav-link" href="{{ path('app_home') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-heading"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'articles' | trans }}
                </span>
            </a>

            <a class="sidenav-link" href="{{ path('music_index') }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-music"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'music' | trans }}
                </span>
            </a>

            <hr>

            <a class="sidenav-link" href="{{ path('music_chart', {'chart':'trends'}) }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-fire-alt"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'trends' | trans }}
                </span>
            </a>

            <a class="sidenav-link" href="{{ path('music_chart', {'chart':'novelty'}) }}">
                <span class="dashbar-nav-icon">
                    <i class="fas fa-certificate"></i>
                </span>

                <span class="dashbar-nav-name">
                    {{ 'novelty' | trans }}
                </span>
            </a>

        </div>

    {% endif %}

</div>
