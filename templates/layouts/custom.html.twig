<script>
    // Add to Image on change
    if (document.getElementById('articlePreviewImage')) {
        document.getElementById('articlePreviewImage').src = window.URL.createObjectURL(fileInput.files[0]);
    }

    // Add to scripts
    const articlePreviewButton = document.querySelector('#ArticlePreviewButton');
    const articlePreview = document.querySelector('#ArticlePreview');

    const articleTitle = document.querySelector('#article_title');
    const articleContent = document.getElementsByClassName('ck-content');

    function articlePreviewer() {
        articlePreview.style.display = 'block';
        articlePreview.querySelector('h3').innerHTML = articleTitle.value;
        articlePreview.querySelector('.content').innerHTML = articleContent[0].innerHTML;
        location.href = '#ArticlePreviewAnchor';
    }

    articlePreviewButton.addEventListener('click', articlePreviewer);

</script>

{#    Preview Button    #}

<a id="ArticlePreviewButton" href="javascript:void(0)" class="btn btn-secondary">
    Предпросмотр
</a>

{#    Preview Block     #}

<div class="md-article" id="ArticlePreview" style="margin-top: 24px; margin-bottom: 10px; display: none">

    <div id="ArticlePreviewAnchor" style="position: relative; top: -78px;"></div>

    <div class="md-box md-content-padding">

        <div class="article-info">

                <span class="avatar back-picture bp-24" style="background-image: url('{{ vich_uploader_asset(app.user.profile) }}')">
                </span>

            <a class="username" href="{{ path('user_profile', {'username': app.user.username }) }}">
                {{ app.user.username }}
            </a>

            <span class="date">
                    {{ 'now' | format_datetime('medium', 'none', '', 'UTC') }}
                    в
                    {{ 'now' | date(' H:i') }}
                </span>

        </div>

        <h3></h3>

        <div class="article-categories">
            <a class="articles-color" href="javascript:void(0)">
                Categorie
            </a>
        </div>

        <img id="articlePreviewImage" class="article-image" src="" alt="- фотография отсутствует -" style="color: red" width="100%">

        <p class="content mt-2">
        </p>

    </div>

</div>
