<div class="listing-module">
    <strong>{{ title | trans }}: </strong>

    {% for entity in entities %}
        <span class="badge badge-{{ color }} badge-a">
            <a class="md-feat-stat" href="{{ path('' ~ title | trim('s') ~ '_show', {'slug': entity.slug}) }}">
                {{ entity.title }}
            </a>
        </span>
    {% endfor %}
</div>
