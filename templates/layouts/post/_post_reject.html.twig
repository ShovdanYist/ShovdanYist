{{ form_start(form, {action: path('post_moderation_reject', {'id': post.id})}) }}

    {{ form_widget(form.message) }}

    <a href="{{ path('post_moderation_publish', {'id':post.id}) }}" class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.publish.it' | trans }}')">{{ 'publish' | trans }}</a>

    <button class="btn btn-link float-right" onclick="return confirm('{{ 'are.you.sure.to.reject.it' | trans }}')">
        {{ 'reject' | trans }}
    </button>

{{ form_end(form) }}
