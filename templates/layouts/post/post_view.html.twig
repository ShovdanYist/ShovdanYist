<div class="md-post">

    <div class="md-articles-post md-box md-content-padding">

        {{ postInfo(post) }}
        {{ postTitle(post) }}
        {{ postCategories(post) }}
        {{ postImage(post) }}

        {% for song in post.songs %}
            {{ player(song,null,null,null,vich_uploader_asset(post)) }}
        {% endfor %}

        {{ postDescription(post) }}

        {% if type == 'moderation' %}
            <div class="mb-2">
                {{ post.content | raw }}
            </div>
            {{ rejectPost(post) }}
        {% else %}
            {{ postActions(post) }}
        {% endif %}

    </div>

</div>
