{% extends 'base.html.twig' %}

{% block og_title %}{{ singer.fullName }} | Биография, Дискография{% endblock %}

{% block og_image %}{{ vich_uploader_asset(singer) }}{% endblock %}

{% block og_type %}
    <meta property="og:type" content="profile">
    <meta property="profile:first_name" content="{{ singer.firstname }}">
    <meta property="profile:last_name" content="{{ singer.lastname }}">
{% endblock %}

{% block title %}{{ singer.fullName }} | Биография, Дискография{% endblock %}

{% block description %}В ShovdanYist вы сможете найти биографию, дискографию и все песни исполнителя {{ singer.fullName }}, а также все тексты чеченских песен и их переводы.{% endblock %}

{% block keywords %}{{ singer.fullName | lower }} биография, {{ singer.fullName | lower }} дискография, {{ singer.fullName | lower }} все песни, тексты чеченских песен, переводы чеченских песен, под гитару, чеченская музыка{% endblock %}

{% block main_top %}

    {{ breadcrumb({
        (path('app_home')) : ('home.page' | trans),
        (path('music_index')) : ('music' | trans),
        (path('music_singers', {letter: slugify(singer.fullName | first) })) : (singer.fullName | first),
        'active' : (singer.fullName),
    }) }}

{% endblock %}

{% block body %}

    <div class="md-singer-card md-one-singer">

        <h1>{{ singer.fullName }}</h1>

        <div class="md-singer-block">

            <div class="md-singer-image" style="background-image: url('{% if singer.picture %}{{ vich_uploader_asset(singer) | imagine_filter('avatar') }}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')"></div>

            <div class="md-singer-body">

                <p class="card-text">

                    {% if singer.birthDay %}
                        <strong>{{ 'birth.date' | trans }}:</strong> {{ singer.birthDay ? singer.birthDay | format_datetime('medium', 'none', '', 'UTC') }}
                        <br>
                    {% endif %}

                    {% for profession in singer.activity %}
                        <span class="badge badge-success badge-lower">{{ profession.title }}</span>
                    {% endfor %}

                </p>

            </div>

        </div>

    </div>

    <table class="table table-striped table-middle-aligned md-table-carved">

        <thead class="thead-dark">
        <tr>
            <th scope="col"><i class="fas fa-closed-captioning"></i> {{ 'title' | trans }}</th>
            <th scope="col"><i class="fa fa-calendar"></i> {{ 'year' | trans }}</th>
            {% if is_granted('ROLE_ADMIN') %}<th scope="col"><i class="fas fa-eye"></i> {{ 'views' | trans }}</th>{% endif %}
        </tr>
        </thead>

        <tbody>

        {% for song in songs %}

            <tr>
                <td>
                    <a href="{{ path('music_song', {slug: song.slug}) }}">{{ song.title }}</a>
                    <span class="small text-muted">
                        <br>{{ featuring( song, ',<br>' ) }}
                    </span>
                </td>
                <td>{{ song.releaseDate ? song.releaseDate | date("Y") }}</td>
                {% if is_granted('ROLE_ADMIN') %}<td>{{ song.views }}</td>{% endif %}
            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endblock %}
