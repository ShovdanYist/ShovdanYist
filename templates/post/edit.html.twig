{% extends 'base.html.twig' %}

{% block title %}{{ 'article.editing' | trans }}{% endblock %}

{% block body %}

    <h1>{{ 'article.editing' | trans }}</h1>

    {{ form_start(form) }}

        <div class="row label-icons-form">

            <div class="col-12">

                {% if vich_uploader_asset(post) %}
                    <img class="post-image" id="postImgOutput" src="{{ vich_uploader_asset(post) | imagine_filter('post') }}" alt="">
                {% else %}
                    <img class="post-image" id="postImgOutput" src="{{ vich_uploader_asset(post) }}" alt="">
                {% endif %}

                <div style="margin-top: -6px">
                    {{ form_row(form.imageFile) }}
                </div>

                {{ form_row(form.title) }}
                {{ form_row(form.categories) }}
                {{ form_row(form.content) }}
                {{ form_row(form.moderation) }}

                <div class="form-spoiler">

                    <a class="collapsed" data-toggle="collapse" data-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false">
                        {{ 'additional' | trans }} <i></i>
                    </a>

                    <div class="collapse" id="navbarToggleExternalContent">
                        <div class="chosen-songs">
                            {{ form_row(form.songs) }}
                        </div>
                        {{ form_row(form.eventDate) }}

                        {% if is_granted('ROLE_MODER') %}
                            <div class="chosen-search-off">
                                {{ form_widget(form.status) }}
                            </div>
                        {% endif %}
                    </div>

                </div>

                <div class="mt-3">

                    <button class="btn btn-primary" onclick="return confirm('{{ 'are.you.sure.to.change.it' | trans }}')">
                        {{ 'change' | trans }}
                    </button>

                    <a class="btn btn-link float-right" href="{{ path('post_show',{'slug':post.slug}) }}">
                        {{ 'cancel' | trans }}
                    </a>

                </div>

            </div>

        </div>

    {{ form_end(form) }}

{% endblock %}

{% block scripts %}
    {{ ckeditor('author') }}
    {{ chosen() }}
{% endblock %}
