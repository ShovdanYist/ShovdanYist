{% extends 'base.html.twig' %}

{% block title %}{{ 'bookmarks' | trans }}{% endblock %}

{% block main_top %}
    {{ breadcrumb({
        (path('user_profile', {'username': app.user.username} )) : (app.user.username),
        'active' : ('bookmarks' | trans),
    }) }}
{% endblock %}

{% block main %}

    {% for article in articles %}

        <div class="md-article">

            <div class="md-{{ article.section }}-article md-box md-content-padding">

                {{ articleInfo(article) }}
                {{ articleTitle(article) }}
                {{ articleCategories(article) }}
                {{ articleImage(article) }}
                {% for song in article.songs %}
                    {{ player(song,null,null,null,vich_uploader_asset(article)) }}
                {% endfor %}
                {{ articleDescription(article) }}
                {{ articleActions(article) }}

            </div>

        </div>

    {% else %}

        <div class="md-box md-content-padding">{{ 'you.have.not.bookmarks' | trans }}</div>

    {% endfor %}

    {{ paginator.display(true) }}

{% endblock %}

{% block scripts %}
    {{ autoplay() }}
{% endblock %}
