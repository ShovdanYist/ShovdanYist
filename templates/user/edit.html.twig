{% extends 'base.html.twig' %}

{% block title %}Profile editing{% endblock %}

{% block body %}


    <h1 class="border-heading">
        {{ 'profile.editing' | trans }}
    </h1>

    {% if not user.status == 0 or user.status is null %}

    {{ form_start(form) }}

        <div class="row label-icons-form md-edit-form">

            <div class="col-12 md-edit-form-block">

                {% if app.user.status is null %}

                    <div class="md-comment-guest md-alert md-alert-warning md-box-mb">

                        <i class="fas fa-exclamation-triangle"></i> <a href="{{ path('user_settings') }}">Подтвердите электронную почту</a>, чтобы добавить аватар

                    </div>

                    <span style="display: none">

                {% endif %}

                <div id="output-content" style="background-image: url('{% if app.user.profile.avatar != 'avatar.jpg' %}{% if '.gif' in user.profile.avatar %}{{ vich_uploader_asset(app.user.profile) }}{% else %}{{ vich_uploader_asset(app.user.profile) | imagine_filter('avatar') }}{% endif %}{% else %}{{ asset('assets/images/avatar.jpg') }}{% endif %}')">
                </div>
                {{ form_row(form.avatarFile) }}
                {{ form_row(form.avatarDelete) }}

                {% if app.user.status is null or app.user.status == false %}
                    </span>
                {% endif %}

                {{ form_row(form.fullname) }}
                {{ form_row(form.about) }}
                {{ form_row(form.url) }}

                <div class="md-form-gender">
                    {{ form_row(form.gender) }}
                </div>

                {{ form_row(form.birthday) }}

                <div class="mt-3">

                    <button class="btn btn-primary">
                        {{ 'save' | trans }}
                    </button>

                    <a class="btn btn-link float-right" href="{{ path('user_profile', {'username' : user.username }) }}">
                        {{ 'cancel' | trans }}
                    </a>

                </div>

            </div>

        </div>

    {{ form_end(form) }}

    {% else %}

        <div class="md-comment-guest md-alert md-alert-danger md-box-mb mb-0">
            <i class="fas fa-ban"></i> Вы заблокированы и не можете редактировать свою страницу
        </div>

    {% endif %}

{% endblock %}

{% block scripts %}
    {{ ckeditor() }}
{% endblock %}
